#!/bin/bash
# ThinkPad X280 - Gestione e calibrazione display (Wayland / Hyprland)
# Controllato da Win + W (toggle) e all'avvio da execs.lua (init)

STATE_FILE=~/.cache/display_state

apply_settings() {
    # Elimina eventuali vecchi processi gammastep non supportati da Hyprland 0.57
    pkill -x gammastep 2>/dev/null || true

    if [[ $1 == "night" ]]; then
        # Modalità Notte: filtro luce blu riposante nativo (4000K)
        hyprshade on blue-light-filter 2>/dev/null || true
    else
        # Modalità Giorno: calibrazione bilanciata per pannello AUO B125HAN02.2 (D65)
        hyprshade on day-calibration 2>/dev/null || true
    fi

    echo "$1" > "$STATE_FILE"
}

case "$1" in
    "init")
        apply_settings "day"
        ;;
    "toggle")
        current=$(cat "$STATE_FILE" 2>/dev/null || echo "day")
        if [[ $current == "day" ]]; then
            apply_settings "night"
            notify-send "Filtro Luce Blu" "ATTIVO (4000K Notte) 🌙" \
                -h string:x-canonical-private-synchronous:display_mode
        else
            apply_settings "day"
            notify-send "Filtro Luce Blu" "DISATTIVO (6500K Giorno Calibrato) ☀️" \
                -h string:x-canonical-private-synchronous:display_mode
        fi
        
        pkill -RTMIN+8 waybar 2>/dev/null || true
        ;;
esac
