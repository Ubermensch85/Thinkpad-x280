#!/bin/bash
# ThinkPad X280 - Gestione e calibrazione display (Wayland / Hyprland)
# Controllato da Win + W (toggle) e all'avvio da execs.lua (init)

STATE_FILE=~/.cache/display_state

apply_settings() {
    # Termina istanze precedenti di gammastep evitando conflitti sul protocollo Wayland
    if pgrep -x gammastep >/dev/null 2>&1; then
        pkill -x gammastep 2>/dev/null || true
        while pgrep -x gammastep >/dev/null 2>&1; do
            sleep 0.05
        done
    fi

    if [[ $1 == "night" ]]; then
        # Modalità Notte: 4200K riposante, gamma lineare 1.0 (senza alterare la curva naturale)
        gammastep -m wayland -O 4200 -g 1.0:1.0:1.0 >/dev/null 2>&1 &
        sleep 0.15
        if ! pgrep -x gammastep >/dev/null 2>&1; then
            hyprshade on blue-light-filter 2>/dev/null || true
        else
            hyprshade off 2>/dev/null || true
        fi
    else
        # Modalità Giorno: 6500K con correzione bilanciata AUO B125HAN02.2
        # Preserva la piena luminanza dell'hardware ed evita black crush (0.96:0.98:1.02)
        gammastep -m wayland -O 6500 -g 0.96:0.98:1.02 >/dev/null 2>&1 &
        sleep 0.15
        if ! pgrep -x gammastep >/dev/null 2>&1; then
            hyprshade on day-calibration 2>/dev/null || true
        else
            hyprshade off 2>/dev/null || true
        fi
    fi

    echo "$1" > "$STATE_FILE"
}

case "$1" in
    "init")
        apply_settings "day"
        ;;
    "toggle")
        current=$(cat "$STATE_FILE" 2>/dev/null || echo "day")
        if [[ $current == "day" ]]; then
            apply_settings "night"
            notify-send "Filtro Luce Blu" "ATTIVO (4200K Notte) 🌙" \
                -h string:x-canonical-private-synchronous:display_mode
        else
            apply_settings "day"
            notify-send "Filtro Luce Blu" "DISATTIVO (6500K Ottimizzato Giorno) ☀️" \
                -h string:x-canonical-private-synchronous:display_mode
        fi
        
        pkill -RTMIN+8 waybar 2>/dev/null || true
        ;;
esac
