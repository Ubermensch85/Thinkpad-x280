# ~/.config/mako/config
# Tema Nord-Arch coerente con Kitty

# --- Aspetto generale ---
max-visible=5
layer=overlay
anchor=top-right

# --- Dimensioni e padding ---
width=350
height=200
margin=10
padding=14
border-size=1
border-radius=12

# --- Colori base (Nord + Blu Elettrico) ---
background-color=#2E3440E6
text-color=#ECEFF4
border-color=#00A8FF
progress-color=#88C0D0

# --- Font ---
font=Inter 11

# --- Icone ---
icons=1
max-icon-size=32
icon-path=/usr/share/icons/hicolor:/usr/share/icons/Papirus-Dark

# --- Timeout e gestione scadenza (standard desktop) ---
default-timeout=5000
ignore-timeout=0

# --- Comportamento ---
on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss-all
on-touch=dismiss

# --- Stile extra ---
markup=1
actions=1
history=1

# --- Regole specifiche per priorità ---
[urgency=low]
background-color=#2E3440E6
text-color=#88C0D0
border-color=#4C566A
default-timeout=3000

[urgency=normal]
background-color=#2E3440E6
text-color=#ECEFF4
border-color=#00A8FF
default-timeout=5000

[urgency=critical]
background-color=#BF616AF0
text-color=#ECEFF4
border-color=#BF616A
default-timeout=0
