[Unit]
Description=EasyEffects Audio Effects Service
Documentation=https://github.com/wwmm/easyeffects
After=pipewire.service wireplumber.service
Requires=pipewire.service wireplumber.service
PartOf=pipewire.service

[Service]
Type=exec
ExecStart=/usr/bin/easyeffects --service-mode --hide-window
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=default.target
